        }
    },
    "keys": {
        "organisation": "metamac.organisation",
        "languageCookieName": "metamac.internationalization.cookieId",
        "defaultCategoryScheme": "metamac.srm.default.category_scheme.urn",
        "apiKey": "edatos.territory.rest.api_key",
        "layout": {
            "header": "metamac.app.style.header.url",
            "footer": "metamac.app.style.footer.url"
        },
        "statisticalResources": {
            "rest": {
                "external": "metamac.statistical_resources.rest.external"
            }
        },
        "statisticalOperations": {
            "rest": {
                "external": "metamac.statistical_operations.rest.external"
            }
        },
        "structuralResources": {
            "rest": {
                "external": "metamac.srm.rest.external"
            }
        },
        "visualizer": {
            "web": {
                "external": "metamac.portal.web.external.visualizer"
            }
        }
    },
	"appVersion": "@project.version@"
